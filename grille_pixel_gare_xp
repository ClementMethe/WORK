const DRAW_W = 2700, DRAW_H = 900;
const DRAW_CW = cellWidth(DRAW_H), DRAW_COLS = Math.ceil(DRAW_W / DRAW_CW);
const { heights: DRAW_ROW_H, ys: DRAW_ROW_Y } = computeRowMetrics(DRAW_H);
const drawCanvas = document.getElementById('drawCanvas'), drawCtx = drawCanvas.getContext('2d');
const drawResult = document.getElementById('drawResult');
drawCanvas.width = DRAW_W; drawCanvas.height = DRAW_H; drawCtx.clearRect(0,0,DRAW_W,DRAW_H);
const RESULT_W = Math.ceil(DRAW_COLS * DRAW_CW) + 2, RESULT_H = Math.ceil(DRAW_H) + 2;
drawResult.width = RESULT_W; drawResult.height = RESULT_H;
let isDrawing = false, currentTool = 'draw', lastPos = null;

function getDrawState() { return { brushSize: parseInt(document.getElementById('brushSize').value), threshold: parseInt(document.getElementById('drawThreshold').value)/100, color: document.getElementById('drawColor').value }; }

function renderDraw() {
  const s = getDrawState();
  const tmp = document.createElement('canvas'); tmp.width = DRAW_W; tmp.height = DRAW_H;
  const tmpCtx = tmp.getContext('2d'); tmpCtx.drawImage(drawCanvas, 0, 0);
  const pixels = tmpCtx.getImageData(0, 0, DRAW_W, DRAW_H);
  for (let i = 0; i < pixels.data.length; i += 4) { const a = pixels.data[i+3]; pixels.data[i]=pixels.data[i+1]=pixels.data[i+2]=0; pixels.data[i+3]=a>10?a:0; }
  tmpCtx.putImageData(pixels, 0, 0);
  const sp = tmpCtx.getImageData(0,0,DRAW_W,DRAW_H).data;
  const ctx = drawResult.getContext('2d'); ctx.clearRect(0,0,RESULT_W,RESULT_H);
  for (let row = 0; row < 10; row++) {
    const rowY = Math.round(DRAW_ROW_Y[row]), rowH = Math.max(1,Math.round(DRAW_ROW_H[row]));
    for (let col = 0; col < DRAW_COLS; col++) {
      const cellX = Math.round(col*DRAW_CW), cellW = Math.max(1,Math.round(DRAW_CW));
      let filled=0, total=0;
      for (let py=rowY; py<Math.min(rowY+rowH,DRAW_H); py++) for (let px=cellX; px<Math.min(cellX+cellW,DRAW_W); px++) { if(sp[(py*DRAW_W+px)*4+3]>15)filled++; total++; }
      const active = total>0 && filled/total>=s.threshold;
      const x=1+col*DRAW_CW, y=1+DRAW_ROW_Y[row], dw=DRAW_CW-0.5, dh=DRAW_ROW_H[row]-0.5;
      if (active) { ctx.fillStyle=s.color; ctx.fillRect(x,y,dw,dh); }
      else { ctx.fillStyle='rgba(0,0,0,0.03)'; ctx.fillRect(x,y,dw,dh); ctx.strokeStyle='rgba(0,0,0,0.08)'; ctx.lineWidth=0.3; ctx.strokeRect(x+0.15,y+0.15,dw-0.3,dh-0.3); }
    }
  }
}

function getPos(e, c) { const r=c.getBoundingClientRect(), s=e.touches?e.touches[0]:e; return {x:(s.clientX-r.left)*(c.width/r.width), y:(s.clientY-r.top)*(c.height/r.height)}; }
function doStroke(pos) {
  const s=getDrawState(), ink=currentTool==='erase'?'rgba(0,0,0,1)':'#000';
  drawCtx.globalCompositeOperation=currentTool==='erase'?'destination-out':'source-over';
  if(lastPos){drawCtx.strokeStyle=ink;drawCtx.lineWidth=s.brushSize;drawCtx.lineCap='round';drawCtx.beginPath();drawCtx.moveTo(lastPos.x,lastPos.y);drawCtx.lineTo(pos.x,pos.y);drawCtx.stroke();}
  drawCtx.fillStyle=ink;drawCtx.beginPath();drawCtx.arc(pos.x,pos.y,s.brushSize/2,0,Math.PI*2);drawCtx.fill();
  lastPos=pos; renderDraw();
}
drawCanvas.addEventListener('mousedown',  e=>{isDrawing=true;lastPos=null;doStroke(getPos(e,drawCanvas));});
drawCanvas.addEventListener('mousemove',  e=>{if(isDrawing)doStroke(getPos(e,drawCanvas));});
drawCanvas.addEventListener('mouseup',    ()=>{isDrawing=false;lastPos=null;});
drawCanvas.addEventListener('mouseleave', ()=>{isDrawing=false;lastPos=null;});
drawCanvas.addEventListener('touchstart', e=>{e.preventDefault();isDrawing=true;lastPos=null;doStroke(getPos(e,drawCanvas));},{passive:false});
drawCanvas.addEventListener('touchmove',  e=>{e.preventDefault();if(isDrawing)doStroke(getPos(e,drawCanvas));},{passive:false});
drawCanvas.addEventListener('touchend',   ()=>{isDrawing=false;lastPos=null;});
document.getElementById('toolDraw').onclick  = function(){currentTool='draw';this.style.borderColor='#111';document.getElementById('toolErase').style.borderColor='';};
document.getElementById('toolErase').onclick = function(){currentTool='erase';this.style.borderColor='#111';document.getElementById('toolDraw').style.borderColor='';};
document.getElementById('clearDraw').onclick = function(){drawCtx.globalCompositeOperation='source-over';drawCtx.clearRect(0,0,DRAW_W,DRAW_H);drawResult.getContext('2d').clearRect(0,0,RESULT_W,RESULT_H);};

document.getElementById('drawExportSVG').onclick = function(){
  const s=getDrawState(), {heights,ys}=computeRowMetrics(DRAW_H);
  const tmp=document.createElement('canvas');tmp.width=DRAW_W;tmp.height=DRAW_H;
  const tc=tmp.getContext('2d');tc.drawImage(drawCanvas,0,0);
  const px=tc.getImageData(0,0,DRAW_W,DRAW_H);
  for(let i=0;i<px.data.length;i+=4){const l=(px.data[i]+px.data[i+1]+px.data[i+2])/3;px.data[i]=px.data[i+1]=px.data[i+2]=0;px.data[i+3]=255-l;}
  tc.putImageData(px,0,0);
  const pd=tc.getImageData(0,0,DRAW_W,DRAW_H).data;let rects='';
  for(let row=0;row<10;row++){const rowY=Math.round(ys[row]),rowH=Math.max(1,Math.round(heights[row]));
    for(let col=0;col<DRAW_COLS;col++){const cx=Math.round(col*DRAW_CW),cw=Math.max(1,Math.round(DRAW_CW));let f=0,t=0;
      for(let py=rowY;py<Math.min(rowY+rowH,DRAW_H);py++)for(let px2=cx;px2<Math.min(cx+cw,DRAW_W);px2++){if(pd[(py*DRAW_W+px2)*4+3]>15)f++;t++;}
      if(t>0&&f/t>=s.threshold)rects+=`<rect x="${(col*DRAW_CW).toFixed(2)}" y="${ys[row].toFixed(2)}" width="${(DRAW_CW-0.5).toFixed(2)}" height="${(heights[row]-0.5).toFixed(2)}" fill="${s.color}"/>`;
    }}
  const link=document.createElement('a');link.href=URL.createObjectURL(new Blob([`<svg xmlns="http://www.w3.org/2000/svg" width="${(DRAW_COLS*DRAW_CW).toFixed(0)}" height="${DRAW_H}">${rects}</svg>`],{type:'image/svg+xml'}));link.download='dessin-grille.svg';link.click();
};
document.getElementById('drawExportPNG').onclick = function(){drawResult.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='dessin-grille.png';a.click();});};
document.getElementById('brushSize').oninput    = function(){document.getElementById('brushSizeVal').textContent=this.value;};
document.getElementById('drawThreshold').oninput = function(){document.getElementById('drawThreshVal').textContent=this.value;renderDraw();};
document.getElementById('drawColor').oninput = renderDraw;

// GRILLOTHÈQUE
async function chargerEtAfficher() {
  const grid = document.getElementById('grilloGrid');
  grid.innerHTML = '';
  try {
    const liste = await charger();
    if (liste.length === 0) return;
    grid.innerHTML = liste.map(c => `
      <div class="grillo-card" data-png="${c.apercu_png||''}">
        <img src="${c.apercu_png||''}" alt="">
        <div class="grillo-card-info">
          <div class="grillo-card-meta">${c.auteur} · ${new Date(c.created_at).toLocaleDateString('fr-FR',{day:'numeric',month:'short',year:'numeric'})}</div>
        </div>
      </div>
    `).join('');
    grid.querySelectorAll('.grillo-card').forEach(card => {
      card.onclick = function(){
        document.getElementById('lightboxImg').src = this.dataset.png;
        document.getElementById('lightbox').classList.add('open');
      };
    });
  } catch(e) {}
}
document.getElementById('grilloRefresh').onclick = chargerEtAfficher;

// LIGHTBOX
document.getElementById('lightboxClose').onclick = function(){document.getElementById('lightbox').classList.remove('open');};
document.getElementById('lightbox').onclick = function(e){if(e.target===this)this.classList.remove('open');};

// MODAL SAUVEGARDE
let pendingType = null;
function ouvrirModal(type){ pendingType=type; document.getElementById('saveTitle').value=''; document.getElementById('saveAuthor').value=''; document.getElementById('saveModal').classList.add('open'); document.getElementById('saveTitle').focus(); }
document.getElementById('saveFont').onclick   = ()=>ouvrirModal('texte');
document.getElementById('saveDraw').onclick   = ()=>ouvrirModal('dessin');
document.getElementById('saveCancel').onclick = ()=>document.getElementById('saveModal').classList.remove('open');
document.getElementById('saveModal').onclick  = function(e){if(e.target===this)this.classList.remove('open');};

document.getElementById('saveConfirm').onclick = async function(){
  const titre=document.getElementById('saveTitle').value.trim(), auteur=document.getElementById('saveAuthor').value.trim();
  if(!titre||!auteur) return;
  this.disabled=true;
  try {
    let apercu_png='';
    if(pendingType==='texte'){
      const s=getFontState(), CW=cellWidth(s.renderSize)*s.zoom, ec=document.createElement('canvas');
      renderGrid(ec, s.text.split('').map(ch=>pixelizeChar(ch,s)), s.renderSize*s.zoom, CW, CW*s.letterSpacing, s.color);
      apercu_png=ec.toDataURL('image/png');
    } else { apercu_png=drawResult.toDataURL('image/png'); }
    await sauvegarder(auteur, titre, pendingType, apercu_png);
    document.getElementById('saveModal').classList.remove('open');
    if(document.getElementById('mode-grillo').classList.contains('active')) chargerEtAfficher();
  } catch(e){}
  this.disabled=false;
};

// ONGLETS
document.querySelectorAll('.tab').forEach(tab=>{
  tab.onclick=function(){
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.mode').forEach(m=>m.classList.remove('active'));
    this.classList.add('active');
    document.getElementById('mode-'+this.dataset.mode).classList.add('active');
    if(this.dataset.mode==='grillo') chargerEtAfficher();
  };
});

renderFont();
