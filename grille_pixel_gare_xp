const ROW_HEIGHTS  = [19.5, 19.5, 19.5, 19.5, 5, 5, 19.5, 19.5, 19.5, 19.5];
const ROW_TOTAL    = ROW_HEIGHTS.reduce((a, b) => a + b, 0);
const COL_WIDTH    = 5;
const BIG_CANVAS_W = 4000;
const EM = 1000, ASCENDER = 800, DESCENDER = -200;
const FULL_SPECIMEN = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";

function computeRowMetrics(totalHeight) {
  const heights = ROW_HEIGHTS.map(h => h / ROW_TOTAL * totalHeight);
  const ys = []; let y = 0;
  for (let i = 0; i < 10; i++) { ys.push(y); y += heights[i]; }
  return { heights, ys };
}
function cellWidth(totalHeight) { return COL_WIDTH / ROW_TOTAL * totalHeight; }

function pixelizeChar(ch, state) {
  const H = state.renderSize, CW = cellWidth(H);
  const { heights, ys } = computeRowMetrics(H);
  const bigCanvas = document.createElement('canvas');
  bigCanvas.width = BIG_CANVAS_W; bigCanvas.height = H;
  const bigCtx = bigCanvas.getContext('2d');
  bigCtx.font = `${state.fontStyle} ${state.fontWeight} ${H * state.fontSize}px ${state.font}`;
  bigCtx.textBaseline = 'alphabetic'; bigCtx.fillStyle = '#000';
  bigCtx.fillText(ch, BIG_CANVAS_W / 2, H * 0.78 + state.yOffset);
  const pixels = bigCtx.getImageData(0, 0, BIG_CANVAS_W, H).data;
  let minX = BIG_CANVAS_W, maxX = 0, found = false;
  for (let y = 0; y < H; y++) for (let x = 0; x < BIG_CANVAS_W; x++)
    if (pixels[(y * BIG_CANVAS_W + x) * 4 + 3] > 15) { if (x < minX) minX = x; if (x > maxX) maxX = x; found = true; }
  if (!found) return { grid: [], cols: 0, cellW: CW };
  const margin = Math.ceil(CW), cropX = Math.max(0, minX - margin);
  const cropW = Math.min(BIG_CANVAS_W, maxX + margin + 1) - cropX;
  const cropped = document.createElement('canvas');
  cropped.width = cropW; cropped.height = H;
  const croppedCtx = cropped.getContext('2d');
  croppedCtx.drawImage(bigCanvas, cropX, 0, cropW, H, 0, 0, cropW, H);
  const glyphStartX = minX - cropX, glyphCols = Math.ceil((maxX - minX + 1) / CW);
  const croppedPixels = croppedCtx.getImageData(0, 0, cropW, H).data;
  const grid = [];
  for (let row = 0; row < 10; row++) {
    grid[row] = [];
    const rowY = Math.round(ys[row]), rowH = Math.max(1, Math.round(heights[row]));
    for (let col = 0; col < glyphCols; col++) {
      const cellX = Math.round(glyphStartX + col * CW), cellW = Math.max(1, Math.round(CW));
      let filled = 0, total = 0;
      for (let py = rowY; py < Math.min(rowY + rowH, H); py++)
        for (let px = cellX; px < Math.min(cellX + cellW, cropW); px++) { if (croppedPixels[(py * cropW + px) * 4 + 3] > 15) filled++; total++; }
      grid[row][col] = total > 0 && filled / total >= state.threshold;
    }
  }
  return { grid, cols: glyphCols, cellW: CW };
}

function renderGrid(targetCanvas, glyphs, gridHeight, colWidth, letterGap, color) {
  const { heights, ys } = computeRowMetrics(gridHeight);
  const totalWidth = glyphs.reduce((sum, g, i) => sum + g.cols * colWidth + (i < glyphs.length - 1 ? letterGap : 0), 0);
  targetCanvas.width = Math.ceil(totalWidth) + 2; targetCanvas.height = Math.ceil(gridHeight) + 2;
  const ctx = targetCanvas.getContext('2d');
  ctx.clearRect(0, 0, targetCanvas.width, targetCanvas.height);
  let xOffset = 1;
  for (const { grid, cols } of glyphs) {
    for (let row = 0; row < 10; row++) for (let col = 0; col < cols; col++) {
      const x = xOffset + col * colWidth, y = 1 + ys[row], cw = colWidth - 0.5, ch = heights[row] - 0.5;
      if (grid[row] && grid[row][col]) { ctx.fillStyle = color; ctx.fillRect(x, y, cw, ch); }
      else { ctx.fillStyle = 'rgba(0,0,0,0.03)'; ctx.fillRect(x, y, cw, ch); ctx.strokeStyle = 'rgba(0,0,0,0.08)'; ctx.lineWidth = 0.3; ctx.strokeRect(x + 0.15, y + 0.15, cw - 0.3, ch - 0.3); }
    }
    xOffset += cols * colWidth + letterGap;
  }
}

function exportSVG(glyphs, colWidth, gridHeight, letterGap, color, filename) {
  const { heights, ys } = computeRowMetrics(gridHeight);
  const totalWidth = glyphs.reduce((sum, g, i) => sum + g.cols * colWidth + (i < glyphs.length - 1 ? letterGap : 0), 0);
  let rects = '', xOffset = 0;
  for (const { grid, cols } of glyphs) {
    for (let row = 0; row < 10; row++) for (let col = 0; col < cols; col++)
      if (grid[row] && grid[row][col]) { const x = xOffset + col * colWidth; rects += `<rect x="${x.toFixed(2)}" y="${ys[row].toFixed(2)}" width="${(colWidth-0.5).toFixed(2)}" height="${(heights[row]-0.5).toFixed(2)}" fill="${color}"/>`; }
    xOffset += cols * colWidth + letterGap;
  }
  const link = document.createElement('a');
  link.href = URL.createObjectURL(new Blob([`<svg xmlns="http://www.w3.org/2000/svg" width="${totalWidth.toFixed(0)}" height="${gridHeight}">${rects}</svg>`], { type: 'image/svg+xml' }));
  link.download = filename; link.click();
}

function gridToOpenTypePath(grid, cols, colWidth, renderHeight) {
  const { heights, ys } = computeRowMetrics(renderHeight);
  const scale = EM / renderHeight, path = new opentype.Path();
  for (let row = 0; row < 10; row++) {
    const yTop = ASCENDER - (ys[row] / renderHeight) * (ASCENDER - DESCENDER);
    const yBot = ASCENDER - ((ys[row] + heights[row]) / renderHeight) * (ASCENDER - DESCENDER);
    for (let col = 0; col < cols; col++) {
      if (!grid[row] || !grid[row][col]) continue;
      const xL = col * colWidth * scale, xR = (col + 1) * colWidth * scale;
      path.moveTo(xL, yBot); path.lineTo(xL, yTop); path.lineTo(xR, yTop); path.lineTo(xR, yBot); path.close();
    }
  }
  return path;
}

function measureKerning(chars, fontString) {
  const MEASURE_PX = 200, mf = fontString.replace(/\d+(\.\d+)?px/, MEASURE_PX + 'px');
  const c = document.createElement('canvas'); c.width = 2; c.height = 2;
  const ctx = c.getContext('2d'); ctx.font = mf; ctx.fontKerning = 'normal';
  const sw = {}; for (const ch of chars) sw[ch] = ctx.measureText(ch).width;
  const kp = {};
  for (const a of chars) for (const b of chars) { const k = ctx.measureText(a+b).width - sw[a] - sw[b]; if (Math.abs(k) > 0.1) kp[a+'|'+b] = Math.round(k * (EM / MEASURE_PX)); }
  return kp;
}

document.getElementById('exportOTF').onclick = function () {
  if (typeof opentype === 'undefined') return;
  const state = getFontState(), fontName = document.getElementById('fontName').value || 'GrilleTypo';
  const chars = [...new Set(FULL_SPECIMEN.split(''))].filter(c => c.trim() !== '');
  setTimeout(() => {
    const fs = `${state.fontStyle} ${state.fontWeight} ${state.renderSize * state.fontSize}px ${state.font}`;
    const kp = measureKerning(chars, fs);
    const glyphList = [new opentype.Glyph({ name: '.notdef', unicode: 0, advanceWidth: 500, path: new opentype.Path() })];
    const gbc = {};
    for (const ch of chars) {
      const r = pixelizeChar(ch, state); if (!r.cols) continue;
      const g = new opentype.Glyph({ name: 'uni'+ch.codePointAt(0).toString(16).toUpperCase().padStart(4,'0'), unicode: ch.codePointAt(0), advanceWidth: Math.round(r.cols * r.cellW * (EM / state.renderSize)), path: gridToOpenTypePath(r.grid, r.cols, r.cellW, state.renderSize) });
      glyphList.push(g); gbc[ch] = g;
    }
    const font = new opentype.Font({ familyName: fontName, styleName: 'Regular', unitsPerEm: EM, ascender: ASCENDER, descender: DESCENDER, glyphs: glyphList });
    const ke = [];
    for (const [pair, value] of Object.entries(kp)) { const [a,b] = pair.split('|'); if (gbc[a]&&gbc[b]) ke.push({ leftIndex: glyphList.indexOf(gbc[a]), rightIndex: glyphList.indexOf(gbc[b]), value }); }
    if (ke.length > 0) font.tables.kern = { version: 0, subtables: [{ coverage: 1, format: 0, pairs: ke }] };
    font.download(fontName + '.otf');
  }, 50);
};

const mainCanvas = document.getElementById('mainCanvas');

function getFontState() {
  return {
    text: document.getElementById('inputText').value || 'A',
    font: document.getElementById('fontSelect').value,
    fontWeight: document.getElementById('fontWeight').value,
    fontStyle: document.getElementById('fontStyle').value,
    fontSize: parseInt(document.getElementById('fontSize').value) / 100,
    threshold: parseInt(document.getElementById('threshold').value) / 100,
    zoom: parseFloat(document.getElementById('zoom').value),
    renderSize: parseInt(document.getElementById('renderSize').value),
    yOffset: parseInt(document.getElementById('yOffset').value),
    letterSpacing: parseFloat(document.getElementById('letterSpacing').value),
    color: document.getElementById('textColor').value,
  };
}

function renderFont() {
  const s = getFontState(), CW = cellWidth(s.renderSize) * s.zoom, H = s.renderSize * s.zoom;
  renderGrid(mainCanvas, s.text.split('').map(ch => pixelizeChar(ch, s)), H, CW, CW * s.letterSpacing, s.color);
}

document.getElementById('exportSVG').onclick = function () { const s = getFontState(), CW = cellWidth(s.renderSize); exportSVG(s.text.split('').map(ch => pixelizeChar(ch,s)), CW, s.renderSize, CW*s.letterSpacing, s.color, 'typo-grille.svg'); };
document.getElementById('exportPNG').onclick = function () { const s = getFontState(), CW = cellWidth(s.renderSize)*s.zoom, ec = document.createElement('canvas'); renderGrid(ec, s.text.split('').map(ch=>pixelizeChar(ch,s)), s.renderSize*s.zoom, CW, CW*s.letterSpacing, s.color); ec.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='typo-grille.png';a.click();}); };

document.getElementById('customFontInput').addEventListener('change', async function (e) {
