const fontSliders = { threshold:'threshVal', zoom:'zoomVal', renderSize:'rsVal', yOffset:'yOVal', letterSpacing:'lsVal', fontSize:'fontSizeVal' };
for (const [id, labelId] of Object.entries(fontSliders))
